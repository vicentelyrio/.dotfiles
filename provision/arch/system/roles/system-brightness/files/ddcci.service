[Unit]
Description=Bind ddcci kernel driver to DDC/CI-capable monitors
# Wait until graphical/DRM stack is up so ddcutil can enumerate displays.
After=systemd-modules-load.service multi-user.target
Wants=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/backlight-start.sh
# Retry once if the script exits non-zero (e.g. udev hadn't created i2c bus yet).
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
