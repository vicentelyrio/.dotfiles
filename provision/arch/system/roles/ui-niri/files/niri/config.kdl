// vi: ft=kdl

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 200
        repeat-rate 25
    }

    touchpad {
        tap
        natural-scroll
        accel-speed 0.2
    }

    mouse {
        // natural-scroll is a bare flag; omitting it leaves it off.
    }
}

// The 4K display is on DP-3 (per /sys/class/drm), not DP-1. Niri auto-picks a
// fractional scale from the EDID, so this stays off until that looks wrong.
// Config is hot-reloaded, so scale can be tuned live.
// output "DP-3" {
//     mode "3840x2160@60.000"
//     scale 1.2
//     position x=0 y=0
// }

layout {
    gaps 8

    center-focused-column "never"

    preset-column-widths {
        proportion 0.333
        proportion 0.5
        proportion 0.667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#b7bdf8"
        inactive-color "#363a4f"
    }

    border {
        off
    }

    shadow {
        on
        offset x=0 y=4
        softness 20
        spread 5
        color "#00000066"
    }
}

environment {
    DISPLAY ":0"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    GTK_THEME "catppuccin-macchiato-lavender-standard+default"
    GTK_IM_MODULE "cedilla"
    XCURSOR_THEME "catppuccin-macchiato-dark-cursors"
    XCURSOR_SIZE "24"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "qt5ct"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"
    QT_IM_MODULE "cedilla"
    GDK_SCALE "1"
    GDK_BACKEND "wayland,x11,*"
    SDL_VIDEODRIVER "wayland"
    CLUTTER_BACKEND "wayland"
}

cursor {
    xcursor-theme "catppuccin-macchiato-dark-cursors"
    xcursor-size 24
}

screenshot-path "~/Pictures/Screenshots/screenshot_%Y-%m-%d_%H-%M-%S.png"

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

spawn-at-startup "xwayland-satellite"
spawn-at-startup "swaybg" "-m" "fill" "-i" "/home/vicentelyrio/.config/themes/night/assets/wallpapers/flowers.png"
spawn-at-startup "/home/vicentelyrio/.config/niri/scripts/autostart.sh"

binds {
    // Applications
    Mod+Return { spawn "alacritty"; }
    Mod+Space { spawn "fuzzel"; }
    Mod+V { spawn "alacritty" "--class" "clipse" "-e" "clipse"; }
    Mod+B { spawn "zen-browser" "--profile-directory=Default"; }

    // Window management
    Mod+Q { close-window; }
    Mod+Shift+Ctrl+Q { quit; }

    // Float
    Mod+F { toggle-window-floating; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M { maximize-column; }

    // Column sizing
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }

    // Columns: consume/expel
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // Focus
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }

    // Move column ($MOD_BACK = SUPERCONTROL, matching Hyprland)
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+L { move-column-right; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+Up { move-window-up; }

    // Resize (hold to repeat)
    Mod+Alt+H { set-column-width "-5%"; }
    Mod+Alt+L { set-column-width "+5%"; }
    Mod+Alt+K { set-window-height "-5%"; }
    Mod+Alt+J { set-window-height "+5%"; }

    // Monitor off ($MOD_ALT+O matching Hyprland)
    Mod+Alt+O { power-off-monitors; }

    // Lock (routed through logind so it shares swayidle's lock handler)
    Mod+Escape { spawn "loginctl" "lock-session"; }

    // Workspaces ($MOD_SPECIAL+H/L = workspace prev/next, matching Hyprland)
    Mod+Shift+H { focus-workspace-up; }
    Mod+Shift+L { focus-workspace-down; }
    Mod+WheelScrollUp { focus-workspace-up; }
    Mod+WheelScrollDown { focus-workspace-down; }
    Mod+Shift+Ctrl+H { move-workspace-to-monitor-left; }
    Mod+Shift+Ctrl+L { move-workspace-to-monitor-right; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // Move to workspace ($MOD_ALT+1-9 matching Hyprland)
    Mod+Alt+1 { move-window-to-workspace 1; }
    Mod+Alt+2 { move-window-to-workspace 2; }
    Mod+Alt+3 { move-window-to-workspace 3; }
    Mod+Alt+4 { move-window-to-workspace 4; }
    Mod+Alt+5 { move-window-to-workspace 5; }
    Mod+Alt+6 { move-window-to-workspace 6; }
    Mod+Alt+7 { move-window-to-workspace 7; }
    Mod+Alt+8 { move-window-to-workspace 8; }
    Mod+Alt+9 { move-window-to-workspace 9; }

    // Screenshots ($MOD_SPECIAL+3/4 matching Hyprland)
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    Mod+Shift+3 { screenshot-screen; }
    Mod+Shift+4 { screenshot; }

    // Volume
    XF86AudioRaiseVolume allow-when-locked=true { spawn "pamixer" "-ui" "5"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "pamixer" "-ud" "5"; }
    XF86AudioMute allow-when-locked=true { spawn "pamixer" "-t"; }
    F12 allow-when-locked=true { spawn "pamixer" "-ui" "5"; }
    F11 allow-when-locked=true { spawn "pamixer" "-ud" "5"; }
    F10 allow-when-locked=true { spawn "pamixer" "-t"; }

    // Brightness
    XF86MonBrightnessUp { spawn "/home/vicentelyrio/.config/niri/scripts/brightness.sh" "+5"; }
    XF86MonBrightnessDown { spawn "/home/vicentelyrio/.config/niri/scripts/brightness.sh" "-5"; }
    F2 { spawn "/home/vicentelyrio/.config/niri/scripts/brightness.sh" "+5"; }
    F1 { spawn "/home/vicentelyrio/.config/niri/scripts/brightness.sh" "-5"; }

    // Media
    XF86AudioPrev { spawn "playerctl" "previous"; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    F7 { spawn "playerctl" "previous"; }
    F8 { spawn "playerctl" "play-pause"; }
    F9 { spawn "playerctl" "next"; }
}

window-rule {
    match app-id="clipse"
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 700; }
}

window-rule {
    match app-id="org.gnome.Calculator"
    open-floating true
}
